# ---------- runtime ----------
XM_ENV=dev
XM_HOST=127.0.0.1
XM_PORT=8000
XM_LOG_LEVEL=INFO
XM_LOG_JSON=true
XM_DB_PATH=var/crossmind.db
XM_TRACE_DIR=var/traces

# ---------- auth ----------
# 格式：key:tenant,key:tenant   用逗号分隔。生产环境请改为从 Vault/KMS 注入。
XM_API_KEYS=demo-key-alpha:tenant-alpha,demo-key-beta:tenant-beta

# ---------- rate limit ----------
XM_RATE_LIMIT_RPS=20
XM_RATE_LIMIT_BURST=40
XM_MAX_BODY_BYTES=1000000

# ---------- llm ----------
# mock = 离线确定性模型（默认，无需任何密钥）；openai = OpenAI 兼容网关
XM_LLM_PROVIDER=mock
XM_LLM_BASE_URL=https://api.deepseek.com/v1
XM_LLM_API_KEY=
XM_LLM_MODEL=deepseek-chat
XM_LLM_TIMEOUT_S=30
XM_LLM_MAX_RETRIES=2
XM_LLM_MOCK_LATENCY_MS=0

# ---------- embedding ----------
# hash = 本地确定性哈希向量；openai = 远程 embedding 服务
XM_EMBEDDING_PROVIDER=hash
XM_EMBEDDING_DIM=256

# ---------- rag ----------
XM_RAG_CHUNK_SIZE=260
XM_RAG_CHUNK_OVERLAP=0.15
XM_RAG_TOP_K=5
XM_RAG_RECALL_K=20
XM_RAG_SCORE_THRESHOLD=0.18
XM_RAG_EMBED_WEIGHT=0.6
XM_RAG_ANSWERABILITY_GATE=true
XM_RAG_ANSWERABILITY_THRESHOLD=0.30

# ---------- agent / business ----------
XM_HITL_AMOUNT_THRESHOLD=500
XM_MAX_REVIEW_ROUNDS=2
XM_IDEMPOTENCY_TTL_S=86400

